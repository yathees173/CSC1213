public class Bowler extends Player{
	public int wickets;
	
	public Bowler(int playerID, String name, int[] scores){
		super(playerID,name,scores);
	}
	
	public int getWickets(){
		int sum=0;
		for(int i=0; i<scores.length; i++){
			sum=sum+scores[i];
		}
		return sum;
	}
	
	public void addScore(int score){
		if(score>0 && score<10){
			System.out.println("Total wickets : "+getWickets()+score);
		}
		
		else
			System.out.println("The score is should between 0 to 10.");
	}
	
	public void printDetails(){
		System.out.println("Bowler\'s ID: "+getPlayerID());
		System.out.println("Name: "+getName());
		System.out.println("Country: "+getCountry());
		System.out.println("Scores: ");
		System.out.println("Total wickets: ");
	}
}